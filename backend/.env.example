# --- Database ---
# PostgreSQL (recommended):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dermedics
# SQLite fallback for quick local dev:
DATABASE_URL=sqlite:///./dermedics.db
AUTO_CREATE_TABLES=true

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- AI model ---
# Path to trained classifier (produced by ml/train.py). Leave empty to use the demo classifier.
MODEL_PATH=
LABELS_PATH=
CONFIDENCE_THRESHOLD=0.6

# --- LLM (any OpenAI-compatible API). Leave LLM_API_KEY empty to use the offline knowledge base. ---
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=qwen/qwen3.7-flash
# Alibaba Model Studio (Qwen): use the base URL shown on your Model Studio API Key page.
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Optional comma-separated models to try if the main one fails
LLM_FALLBACK_MODELS=

# --- Optional Google Places for live dermatologist search ---
GOOGLE_PLACES_KEY=

CORS_ORIGINS=*

# --- Email for "Forgot password" codes ---
# Gmail: turn on 2-Step Verification, create an App Password (Google Account > Security > App passwords),
# then use SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char app password>.
# Leave SMTP_HOST empty in development: reset codes are printed in the backend console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DerMedics AI <you@gmail.com>
